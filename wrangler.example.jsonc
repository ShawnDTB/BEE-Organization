{
  // Copy to wrangler.jsonc and use the EXISTING Cloudflare Worker name.
  "name": "replace-with-existing-worker-name",
  "main": "server/worker.ts",
  "compatibility_date": "2026-09-14",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "vars": { "APP_ORIGIN": "https://worksbybee.com", "INTAKE_ENABLED": "false" }
  // Add DB as a D1 binding using the actual database ID; never commit secrets.
}
