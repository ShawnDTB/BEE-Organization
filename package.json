    "test": "vitest run"
  },
  "dependencies": {
    "jose": "6.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "6.0.2",
    "vite": "7.3.6",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.19.0",
    "npm": ">=10.0.0"
  }
}
