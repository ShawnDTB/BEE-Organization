{
  "name": "bee-organization-platform",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/metadata.mjs",
    "preview": "vite preview",
